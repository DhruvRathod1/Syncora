{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "allowJs": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": false,
        "allowImportingTsExtensions": true,
        "outDir": "dist",
        "rootDir": "."
    },
    "include": [
        "src/**/*",
        "server.ts",
        "scripts/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
<div class="stack mt-3">
    <div class="cluster" style="justify-content: space-between;">
        <div>
            <h1>Your Boards</h1>
            <% if (user) { %>
                <p class="muted">Logged in as <%= user.email %>
                </p>
                <% } %>
        </div>
        <% if (user) { %>
            <form method="GET" action="/logout">
                <button type="submit" class="secondary">Logout</button>
            </form>
            <% } %>
    </div>

    <div class="card">
        <h3>Create a Board</h3>
        <form method="POST" action="/boards/create" style="max-width: 400px;">
            <input name="title" placeholder="Board title" required />
            <button type="submit">Create Board</button>
        </form>
    </div>

    <div class="card">
        <h3>My Boards</h3>
        <% if ((boards || []).length===0) { %>
            <p class="muted">No boards yet. Create one above!</p>
            <% } else { %>
                <ul>
                    <% boards.forEach(function(board){ %>
                        <li>
                            <a href="/board/<%= board.id %>">
                                <%= board.title %>
                            </a>
                        </li>
                        <% }) %>
                </ul>
                <% } %>
    </div>

    <% if ((invites || []).length) { %>
        <div class="card">
            <h3>Pending Invites</h3>
            <ul>
                <% invites.forEach(function(inv){ %>
                    <li>
                        <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem;">
                            <div>
                                <strong>
                                    <%= inv.boardTitle %>
                                </strong>
                                <span class="muted"> — <%= inv.role %></span>
                            </div>
                            <div class="cluster">
                                <form method="POST" action="/invites/<%= inv.boardId %>/accept">
                                    <button type="submit"
                                        style="padding: .4rem .7rem; font-size: .9rem;">Accept</button>
                                </form>
                                <form method="POST" action="/invites/<%= inv.boardId %>/reject">
                                    <button type="submit" class="secondary"
                                        style="padding: .4rem .7rem; font-size: .9rem;">Reject</button>
                                </form>
                            </div>
                        </div>
                    </li>
                    <% }) %>
            </ul>
        </div>
        <% } %>
</div>
<div class="center" style="max-width: 420px; margin-top: 3rem;">
  <div class="card">
    <h2 style="margin-bottom: 1rem;">Login</h2>

    <% if (query && query.registered) { %>
      <div class="msg success mb-2">
        Registered <%= query.email %>. Please login.
      </div>
      <% } %>

        <% if (query && query.loggedout) { %>
          <div class="msg success mb-2">
            You have logged out.
          </div>
          <% } %>

            <% if (query && query.error) { %>
              <div class="msg error mb-2">
                Login failed. Please try again.
              </div>
              <% } %>

                <form method="POST" action="/auth/login">
                  <input name="email" type="email" placeholder="Email" value="<%= query?.email || '' %>" required />
                  <input name="password" type="password" placeholder="Password" required />
                  <button type="submit">Login</button>
                </form>

                <p class="mt-2 muted" style="text-align: center;">
                  Don't have an account? <a href="/register">Register</a>
                </p>
  </div>
</div>